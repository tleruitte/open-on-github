{
  "name": "open-on-github",
  "displayName": "Open on GitHub",
  "description": "Opens the current file and line on GitHub in the repository default branch.",
  "version": "0.1.0",
  "publisher": "tleruitte",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:openOnGithub.openCurrentLine"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openOnGithub.openCurrentLine",
        "title": "Open Current Line on GitHub"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
