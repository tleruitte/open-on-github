{
  "name": "open-on-github",
  "displayName": "Open on GitHub",
  "description": "Opens the current file and line on GitHub in the repository default branch.",
  "icon": "images/icon.png",
  "version": "0.1.2",
  "publisher": "tleruitte",
  "repository": {
    "type": "git",
    "url": "https://github.com/tleruitte/open-on-github.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:openOnGithub.openCurrentLine"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openOnGithub.openCurrentLine",
        "title": "Open Current Line on GitHub"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepackage": "node -e \"require('node:fs').mkdirSync('releases', { recursive: true })\"",
    "package": "npx @vscode/vsce package --out releases"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
